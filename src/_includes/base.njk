<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set sidtitel = seo_titel or titel or startsida.seo_titel %}
  {%- set sidbeskrivning = seo_beskrivning or beskrivning or startsida.seo_beskrivning %}
  {%- set delningsbild = ogbild or "/img/og.jpg" %}
  <title>{{ sidtitel }}</title>
  <meta name="description" content="{{ sidbeskrivning }}">
  {%- if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.namn }}">
  <meta property="og:title" content="{{ sidtitel }}">
  <meta property="og:description" content="{{ sidbeskrivning }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ delningsbild }}">
  <meta property="og:type" content="{{ ogtyp or 'website' }}">
  <meta property="og:locale" content="sv_SE">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#f7f2ea">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/img/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preload" href="/fonts/fraunces-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  <script type="application/ld+json">{{ schema.foretag(site, startsida) | dump | safe }}</script>
  {%- if page.url == "/" and faq.fragor.length %}
  <script type="application/ld+json">{{ schema.faqSida(faq.fragor) | dump | safe }}</script>
  {%- endif %}
  {%- if extraSchema %}
  <script type="application/ld+json">{{ extraSchema | dump | safe }}</script>
  {%- endif %}
</head>
<body>

<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="{{ site.namn }} – till startsidan">
      <img src="/img/logo-header.png" alt="{{ site.namn }} – cateringtjänster" width="720" height="123" eleventy:ignore>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Öppna menyn">
      <span></span><span></span><span></span>
    </button>
    <nav id="nav" class="nav" aria-label="Huvudmeny">
      {%- for t in collections.tjanst %}{% if t.data.meny_namn %}
      <a href="{{ t.url }}">{{ t.data.meny_namn }}</a>
      {%- endif %}{% endfor %}
      {%- if synlighet.event and collections.kommandeEvent.length %}
      <a href="/event/">Event</a>
      {%- endif %}
      {%- if synlighet.nyheter %}
      <a href="/nyheter/">Nyheter</a>
      {%- endif %}
      <a href="/#om-oss">Om oss</a>
      <a href="{{ "#offertformular" if harKontakt else "/#offertformular" }}" class="btn btn-small">Begär offert</a>
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/img/logo.png" alt="{{ site.namn }}" width="600" height="370" eleventy:ignore>
      <p>{{ site.beskrivning }}</p>
    </div>
    <nav aria-label="Tjänster">
      <h2>Tjänster</h2>
      <ul>
        {%- for t in collections.tjanst %}
        <li><a href="{{ t.url }}">{{ t.data.kort_namn }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div>
      <h2>Kontakt</h2>
      <p>{{ site.gatuadress }}<br>{{ site.postnummer }} {{ site.ort }}</p>
      <p><a href="mailto:{{ site.epost }}">{{ site.epost }}</a><br><a href="tel:{{ site.telefon | tel }}">{{ site.telefon }}</a><br>
        <a href="https://www.instagram.com/{{ site.instagram_anvandare }}/" target="_blank" rel="noopener">Instagram</a></p>
      <p><a href="/integritetspolicy/">Integritetspolicy</a></p>
    </div>
  </div>
</footer>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('nav');
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open);
  });
  // Hoppa till offertformuläret och håll det kvar i bild om sidan ovanför ändrar höjd
  // (t.ex. när Instagram-flödet laddas in efter hoppet)
  function tillFormular(smooth) {
    const f = document.getElementById('offertformular');
    if (!f) return false;
    f.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
    const ro = new ResizeObserver(() => f.scrollIntoView());
    ro.observe(document.body);
    const sluta = () => { ro.disconnect(); ['wheel', 'touchstart', 'keydown'].forEach(t => removeEventListener(t, sluta)); };
    ['wheel', 'touchstart', 'keydown'].forEach(t => addEventListener(t, sluta, { passive: true }));
    setTimeout(sluta, 3000);
    return true;
  }
  document.addEventListener('click', e => {
    const a = e.target.closest('a[href$="#offertformular"]');
    // Knappar med data-typ väljer rätt alternativ i formuläret, t.ex. "Presentkorg"
    const val = a && a.dataset.typ;
    const sel = document.querySelector('#offertformular select[name="typ"]');
    if (val && sel && [...sel.options].some(o => o.value === val)) { sel.value = val; anpassaFormular(); }
    // "Anmäl dig" på ett event väljer eventet i formuläret
    const ev = document.querySelector('#offertformular select[name="event"]');
    if (a && a.dataset.event && ev && [...ev.options].some(o => o.value === a.dataset.event)) {
      ev.value = a.dataset.event;
      const msg = document.querySelector('#offertformular textarea[name="meddelande"]');
      if (msg && 'ko' in a.dataset && !msg.value) msg.value = 'Jag vill stå i kö om en plats blir ledig.';
    }
    if (a && a.pathname === location.pathname && tillFormular(true)) {
      e.preventDefault();
      history.replaceState(null, '', '#offertformular');
    }
  });
  // När "Anmälan till event" är valt visas eventlistan i formuläret, och datumfältet döljs
  function anpassaFormular() {
    const f = document.getElementById('offertformular');
    const typ = f && f.querySelector('select[name="typ"]');
    if (!typ) return;
    const arEvent = typ.value === 'Anmälan till event';
    const evLabel = f.querySelector('.form-event');
    if (evLabel) { evLabel.hidden = !arEvent; evLabel.querySelector('select').disabled = !arEvent; }
    const datum = f.querySelector('.form-datum');
    if (datum) { datum.hidden = arEvent; datum.querySelector('input').disabled = arEvent; }
    const antal = f.querySelector('.form-antal');
    if (antal) antal.textContent = arEvent ? 'Antal platser' : 'Antal gäster';
    f.querySelector('.form-rubrik').textContent = arEvent ? 'Anmälan' : 'Offertförfrågan';
    const valtEv = f.querySelector('select[name="event"]')?.selectedOptions[0];
    f.querySelector('.form-skicka').textContent = !arEvent ? 'Skicka förfrågan' : valtEv?.dataset.full ? 'Ställ dig i kö' : 'Skicka anmälan';
    const antalIn = f.querySelector('input[name="antal"]');
    if (antalIn) { antalIn.required = arEvent; antalIn.max = arEvent && valtEv?.dataset.kvar && !valtEv.dataset.full ? Math.min(20, +valtEv.dataset.kvar) : ''; }
    const fel = f.querySelector('.form-fel'); if (fel) fel.hidden = true;
    const msg = f.querySelector('textarea[name="meddelande"]');
    if (msg) { msg.dataset.ph ??= msg.placeholder; msg.placeholder = arEvent ? 'Allergier, önskemål …' : msg.dataset.ph; }
  }
  document.querySelector('#offertformular select[name="typ"]')?.addEventListener('change', anpassaFormular);
  document.querySelector('#offertformular select[name="event"]')?.addEventListener('change', anpassaFormular);
  anpassaFormular();
  // Passerade event döljs dagen efter, även om sidan inte har byggts om sedan dess
  {
    const d = new Date(), idag = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    document.querySelectorAll('.event-card[data-dag]').forEach(c => { if (c.dataset.dag < idag) c.remove(); });
    document.querySelectorAll('[data-event-lista]').forEach(l => {
      if (!l.querySelector('.event-card')) { l.querySelector('.event-empty').hidden = false; l.closest('[data-event-sektion]')?.remove(); }
    });
    document.querySelectorAll('#offertformular select[name="event"] option[data-dag]').forEach(o => { if (o.dataset.dag < idag) o.remove(); });
    const sida = document.querySelector('[data-event-sida]');
    if (sida && sida.dataset.dag < idag) {
      sida.querySelector('.event-passerat').hidden = false;
      sida.querySelectorAll('.event-facts .btn, .event-facts .event-status').forEach(e => e.remove());
      document.getElementById('kontakt')?.remove();
    }
  }
  // Lediga platser hämtas live, så att siffrorna alltid stämmer med bokningarna
  const evOptions = document.querySelectorAll('#offertformular select[name="event"] option[data-ev]');
  evOptions.forEach(o => { if (/fullbokat/.test(o.textContent)) o.dataset.full = '1'; });
  if (document.querySelector('[data-ev], option[data-kapacitet]')) {
    fetch('/api/platser').then(r => r.ok ? r.json() : {}).then(platser => {
      const stat = (el, klass, text) => { if (!el) return; el.className = 'event-status event-status-' + klass; el.textContent = text; };
      document.querySelectorAll('[data-ev]:not(option)').forEach(box => {
        const i = platser[box.dataset.ev];
        if (!i || i.kvar === null) return;
        const full = i.stangd || i.kvar === 0;
        stat(box.querySelector('[data-ev-status]'), full ? 'fullbokat' : i.kvar <= 3 ? 'fa' : 'platser',
          full ? 'Fullbokat' : i.kvar <= 3 ? `Bara ${i.kvar} ${i.kvar === 1 ? 'plats' : 'platser'} kvar` : `${i.kvar} platser kvar`);
        box.querySelectorAll('[data-ev-knapp]').forEach(b => {
          b.textContent = full ? 'Ställ dig i kö' : 'Anmäl dig';
          b.classList.toggle('btn-ghost-dark', full);
          if (full) b.dataset.ko = ''; else delete b.dataset.ko;
        });
        const antal = box.querySelector('[data-ev-antal]');
        if (antal) antal.textContent = full ? `Alla ${i.kapacitet} platser är bokade` : `${i.kvar} av ${i.kapacitet} platser kvar`;
      });
      evOptions.forEach(o => {
        const i = platser[o.dataset.ev];
        if (!i || i.kvar === null) return;
        const full = i.stangd || i.kvar === 0;
        o.dataset.kvar = i.kvar;
        if (full) o.dataset.full = '1'; else delete o.dataset.full;
        o.textContent = o.value + (full ? ' (fullbokat – kö)' : '');
      });
      anpassaFormular();
    }).catch(() => {});
  }
  // Anmälan till event med antal platser bokas via hemsidans bokningssystem,
  // och skickas sedan som vanligt vidare som mejl.
  document.getElementById('offertformular')?.addEventListener('submit', async e => {
    const f = e.currentTarget;
    const opt = f.querySelector('select[name="event"]:not(:disabled)')?.selectedOptions[0];
    if (!opt || !opt.dataset.ev || f.dataset.skickar === 'vanligt') return;
    e.preventDefault();
    if (f.dataset.skickar) return;
    const fel = f.querySelector('.form-fel'), knapp = f.querySelector('.form-skicka'), knapptext = knapp.textContent;
    const visaFel = t => { fel.textContent = t; fel.hidden = false; fel.scrollIntoView({ block: 'center', behavior: 'smooth' }); };
    const data = Object.fromEntries(new FormData(f));
    const ko = !!opt.dataset.full;
    f.dataset.skickar = '1'; knapp.disabled = true; knapp.textContent = 'Skickar …';
    const mejla = async (status) => {
      f.querySelector('input[name="bokning"]').value = status;
      await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(f)).toString() }).catch(() => {});
    };
    try {
      const r = await fetch('/api/boka', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, event: opt.dataset.ev, ko }) });
      const svar = await r.json().catch(() => ({}));
      if (r.ok && svar.ok) {
        await mejla(svar.ko ? 'Kö (finns i bokningslistan)' : 'Bokad (finns i bokningslistan)');
        location.href = '/tack/?anmalan=' + (svar.ko ? 'ko' : 'bokad');
        return;
      }
      if (r.status >= 500 || !svar.fel) throw new Error();
      if (svar.kvar === 0) { opt.dataset.full = '1'; opt.dataset.kvar = 0; opt.textContent = opt.value + ' (fullbokat – kö)'; }
      else if (svar.kvar) opt.dataset.kvar = svar.kvar;
      anpassaFormular();
      visaFel(svar.fel + (svar.kvar === 0 ? ' Klicka på knappen igen så ställer du dig i kö.' : ''));
    } catch {
      // Bokningssystemet svarar inte: skicka som vanligt mejl, så att anmälan inte försvinner
      f.querySelector('input[name="bokning"]').value = 'EJ registrerad i bokningslistan – lägg in den för hand';
      f.dataset.skickar = 'vanligt'; f.submit(); return;
    }
    delete f.dataset.skickar; knapp.disabled = false; if (knapp.textContent === 'Skickar …') knapp.textContent = knapptext;
  });
  if (location.hash === '#offertformular') addEventListener('load', () => tillFormular(false));
  // Omdömen: "Läs mer" för långa texter, och karusell som rullar av sig själv när det finns fler än tre
  document.querySelectorAll('.review').forEach(r => {
    const t = r.querySelector('.review-text'), b = r.querySelector('.review-more');
    if (t && b && t.scrollHeight > t.clientHeight + 2) {
      b.hidden = false;
      b.addEventListener('click', () => { const open = r.classList.toggle('is-open'); b.textContent = open ? 'Visa mindre' : 'Läs mer'; });
    }
  });
  document.querySelectorAll('[data-carousel]').forEach(c => {
    const track = c.querySelector('.reviews-track');
    const step = () => { const card = track.querySelector('.review'); return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0) : track.clientWidth; };
    const go = dir => {
      const max = track.scrollWidth - track.clientWidth - 2;
      if (dir > 0 && track.scrollLeft >= max) track.scrollTo({ left: 0 });
      else if (dir < 0 && track.scrollLeft <= 2) track.scrollTo({ left: track.scrollWidth });
      else track.scrollBy({ left: dir * step() });
    };
    c.querySelectorAll('.reviews-btn').forEach(b => b.addEventListener('click', () => { go(+b.dataset.dir); paus = true; }));
    let paus = false;
    ['mouseenter', 'focusin', 'touchstart'].forEach(ev => c.addEventListener(ev, () => { paus = true; }, { passive: true }));
    c.addEventListener('mouseleave', () => { paus = false; });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => { if (!paus && !document.hidden && c.getBoundingClientRect().top < innerHeight) go(1); }, 6000);
    }
  });
  // Google-kartan laddas först när besökaren klickar på "Visa karta"
  document.querySelectorAll('.map-consent').forEach(m => m.querySelector('.map-show').addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.className = 'map'; f.title = m.dataset.title; f.src = m.dataset.src;
    f.referrerPolicy = 'no-referrer-when-downgrade';
    m.replaceWith(f);
  }));
  nav.addEventListener('click', e => {
    if (e.target.tagName === 'A') { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', false); }
  });
</script>
</body>
</html>
