<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set sidtitel = seo_titel or titel or startsida.seo_titel %}
  {%- set sidbeskrivning = seo_beskrivning or beskrivning or startsida.seo_beskrivning %}
  {%- set delningsbild = ogbild or "/img/og.jpg" %}
  <title>{{ sidtitel }}</title>
  <meta name="description" content="{{ sidbeskrivning }}">
  {%- if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.namn }}">
  <meta property="og:title" content="{{ sidtitel }}">
  <meta property="og:description" content="{{ sidbeskrivning }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ delningsbild }}">
  <meta property="og:type" content="{{ ogtyp or 'website' }}">
  <meta property="og:locale" content="sv_SE">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#f7f2ea">
  <link rel="icon" href="/img/logo.png">
  <link rel="preload" href="/fonts/jost-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/cormorant-garamond-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  <script type="application/ld+json">{{ schema.foretag(site, startsida) | dump | safe }}</script>
  {%- if page.url == "/" and faq.fragor.length %}
  <script type="application/ld+json">{{ schema.faqSida(faq.fragor) | dump | safe }}</script>
  {%- endif %}
  {%- if extraSchema %}
  <script type="application/ld+json">{{ extraSchema | dump | safe }}</script>
  {%- endif %}
</head>
<body>

<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="{{ site.namn }} – till startsidan">
      <img src="/img/logo-header.png" alt="{{ site.namn }} – cateringtjänster" width="720" height="123" eleventy:ignore>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Öppna menyn">
      <span></span><span></span><span></span>
    </button>
    <nav id="nav" class="nav" aria-label="Huvudmeny">
      <a href="/catering-kungalv/">Catering</a>
      <a href="/brollopscatering/">Bröllop</a>
      <a href="/minnesstund-catering/">Minnesstund</a>
      <a href="/foretagscatering/">Företag &amp; event</a>
      <a href="/nyheter/">Nyheter</a>
      <a href="/#om-oss">Om oss</a>
      <a href="{{ "#kontakt" if harKontakt else "/#kontakt" }}" class="btn btn-small">Begär offert</a>
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/img/logo.png" alt="{{ site.namn }}" width="600" height="370" eleventy:ignore>
      <p>{{ site.beskrivning }}</p>
    </div>
    <nav aria-label="Tjänster">
      <h2>Tjänster</h2>
      <ul>
        {%- for t in collections.tjanst %}
        <li><a href="{{ t.url }}">{{ t.data.kort_namn }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div>
      <h2>Kontakt</h2>
      <p>{{ site.gatuadress }}<br>{{ site.postnummer }} {{ site.ort }}</p>
      <p><a href="tel:{{ site.telefon | tel }}">{{ site.telefon }}</a><br><a href="mailto:{{ site.epost }}">{{ site.epost }}</a><br>
        <a href="https://www.instagram.com/{{ site.instagram_anvandare }}/" target="_blank" rel="noopener">Instagram</a></p>
    </div>
  </div>
</footer>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('nav');
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open);
  });
  nav.addEventListener('click', e => {
    if (e.target.tagName === 'A') { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', false); }
  });
</script>
</body>
</html>
