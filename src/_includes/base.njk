<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ titel or startsida.seo_titel }}</title>
  <meta name="description" content="{{ beskrivning or startsida.seo_beskrivning }}">
  <meta property="og:title" content="{{ titel or startsida.seo_titel }}">
  <meta property="og:description" content="{{ beskrivning or startsida.seo_beskrivning }}">
  <meta property="og:image" content="{{ site.url }}{{ ogbild or startsida.hero_bild }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="sv_SE">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FoodEstablishment",
    "name": {{ site.namn | dump | safe }},
    "url": "{{ site.url }}/",
    "email": {{ site.epost | dump | safe }},
    "telephone": "{{ site.telefon | tel }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ site.gatuadress | dump | safe }},
      "postalCode": {{ site.postnummer | dump | safe }},
      "addressLocality": {{ site.ort | dump | safe }},
      "addressCountry": "SE"
    },
    "servesCuisine": "Catering",
    "sameAs": ["https://www.instagram.com/{{ site.instagram_anvandare }}/"]
  }
  </script>
</head>
<body>

<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="{{ site.namn }} – till startsidan">
      <img src="/img/logo-header.png" alt="{{ site.namn }} – cateringtjänster" width="480" height="305" eleventy:ignore>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Öppna menyn">
      <span></span><span></span><span></span>
    </button>
    <nav id="nav" class="nav">
      <a href="/#catering">Catering</a>
      <a href="/#privat-kock">Privat kock</a>
      <a href="/#lokalen">Lokal &amp; event</a>
      <a href="/nyheter/">Nyheter</a>
      <a href="/#om-oss">Om oss</a>
      <a href="/#kontakt" class="btn btn-small">Begär offert</a>
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <img src="/img/logo.png" alt="{{ site.namn }}" width="600" height="370" eleventy:ignore>
    <p>{{ site.namn }} · {{ site.gatuadress }}, {{ site.postnummer }} {{ site.ort }}<br>
      <a href="tel:{{ site.telefon | tel }}">{{ site.telefon }}</a> · <a href="mailto:{{ site.epost }}">{{ site.epost }}</a> ·
      <a href="https://www.instagram.com/{{ site.instagram_anvandare }}/" target="_blank" rel="noopener">Instagram</a></p>
  </div>
</footer>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('nav');
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open);
  });
  nav.addEventListener('click', e => {
    if (e.target.tagName === 'A') { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', false); }
  });
</script>
</body>
</html>
