---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.data.noindex and not p.data.utkast and not (p.url == "/event/" and not collections.kommandeEvent.length) %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ p.date | isodatum }}</lastmod>
  </url>
{%- endif %}{% endfor %}
</urlset>
