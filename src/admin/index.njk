permalink: /admin/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Admin – Mat på Fat</title>
  <link href="/admin/config.yml" type="application/yaml" rel="cms-config-url">
</head>
<body>
  <!-- Genväg till bokningslistan för event -->
  <a href="/admin/bokningar/" class="mpf-bokningar" title="Anmälningar till event">📋 Bokningar</a>
  <style>
    .mpf-bokningar { position: fixed; left: 16px; bottom: 16px; z-index: 2147483000; display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: 999px; background: #4a5a3f; color: #fff; font: 500 14px/1.2 system-ui, sans-serif;
      text-decoration: none !important; box-shadow: 0 4px 14px rgba(0,0,0,.18); }
    .mpf-bokningar[hidden] { display: none; }
    @media (max-width: 768px) { .mpf-bokningar { bottom: 88px; } }
    .mpf-bokningar:hover { background: #343f2c; }
  </style>
  <script>
    // Visa knappen bara i listorna, inte när man redigerar något (då skulle den skymma fälten)
    (() => {
      const k = document.querySelector('.mpf-bokningar');
      const visa = () => { k.hidden = /\/(entries|new)\b/.test(location.hash); };
      addEventListener('hashchange', visa); visa();
    })();
  </script>

  <!-- Publicera: sparade ändringar ligger på grenen utkast tills någon publicerar dem (en deploy för allt) -->
  <button type="button" class="mpf-publicera" hidden>Publicera</button>
  <div class="mpf-pub-panel" hidden role="dialog" aria-label="Publicera ändringar">
    <div class="mpf-pub-box">
      <div class="mpf-pub-head"><strong>Publicera på hemsidan</strong><button type="button" class="mpf-pub-stang" aria-label="Stäng">✕</button></div>
      <p class="mpf-pub-info"></p>
      <ul class="mpf-pub-lista"></ul>
      <div class="mpf-pub-knappar">
        <button type="button" class="mpf-pub-go">Publicera alla</button>
      </div>
      <p class="mpf-pub-not">Spara gör att ändringen sparas men inte syns. Den syns på hemsidan 1–2 minuter efter att du tryckt Publicera. Samla gärna flera ändringar och publicera dem tillsammans.</p>
    </div>
  </div>
  <style>
    .mpf-publicera { position: fixed; left: 150px; bottom: 16px; z-index: 2147483000; padding: 8px 14px; border: 0; border-radius: 999px;
      background: #fff; color: #4a5a3f; font: 600 14px/1.2 system-ui, sans-serif; box-shadow: 0 4px 14px rgba(0,0,0,.18); cursor: pointer; }
    .mpf-publicera.vantar { background: #c8742a; color: #fff; }
    .mpf-publicera[hidden], .mpf-pub-panel[hidden] { display: none; }
    @media (max-width: 768px) { .mpf-publicera { bottom: 88px; } }
    .mpf-pub-panel { position: fixed; inset: 0; z-index: 2147483001; background: rgba(0,0,0,.35); display: grid; place-items: center; padding: 16px; }
    .mpf-pub-box { background: #fff; color: #222; border-radius: 16px; width: min(480px, 100%); max-height: 85vh; overflow: auto; padding: 18px;
      font: 15px/1.45 system-ui, sans-serif; box-shadow: 0 12px 40px rgba(0,0,0,.25); }
    .mpf-pub-head { display: flex; justify-content: space-between; align-items: center; font-size: 17px; }
    .mpf-pub-stang { border: 0; background: none; font-size: 18px; cursor: pointer; color: #666; }
    .mpf-pub-lista { padding-left: 18px; margin: 8px 0 14px; }
    .mpf-pub-lista li { margin: 4px 0; }
    .mpf-pub-lista small { color: #777; }
    .mpf-pub-go { width: 100%; padding: 12px; border: 0; border-radius: 10px; background: #4a5a3f; color: #fff; font: 600 16px system-ui, sans-serif; cursor: pointer; }
    .mpf-pub-go:disabled { opacity: .5; cursor: default; }
    .mpf-pub-not { color: #777; font-size: 13px; margin: 12px 0 0; }
    .mpf-pub-info.fel { color: #b3412e; }
    .mpf-pub-info.ok { color: #2f7d4f; font-weight: 600; }
  </style>
  <script>
    (() => {
      const REPO = 'kimnyblom-spec/mpfWeb', API = `https://api.github.com/repos/${REPO}`;
      const knapp = document.querySelector('.mpf-publicera'), panel = document.querySelector('.mpf-pub-panel');
      const info = panel.querySelector('.mpf-pub-info'), lista = panel.querySelector('.mpf-pub-lista'), go = panel.querySelector('.mpf-pub-go');
      let vantande = [];

      // Admins GitHub-inloggning (sparad av Sveltia CMS)
      const token = () => { try { return JSON.parse(localStorage.getItem('sveltia-cms.user') || 'null')?.token || null } catch { return null } };
      const gh = async (path, opts = {}) => {
        const r = await fetch(API + path, { ...opts, headers: { Accept: 'application/vnd.github+json', Authorization: `Bearer ${token()}`, ...(opts.headers || {}) } });
        return r;
      };
      // "Uppdatera Event: 2026-11-24-jullunch-med-kollegorna" → "Uppdatera Event: jullunch med kollegorna"
      const snygga = (m) => m.split('\n')[0].replace(/^Ladda upp src\/uploads\//, 'Ny bild: ').replace(/^Ta bort src\/uploads\//, 'Ta bort bild: ').replace(/(\d{4}-\d{2}-\d{2}-)?([a-z0-9]+(?:-[a-z0-9]+)+)\s*$/i, (_, d, slug) => slug.replace(/-/g, ' '));
      const tid = (iso) => new Date(iso).toLocaleString('sv-SE', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

      async function kolla() {
        if (!token()) { knapp.hidden = true; return; }
        try {
          const r = await gh('/compare/main...utkast');
          if (!r.ok) { knapp.hidden = true; return; }
          const d = await r.json();
          vantande = (d.commits || []).filter((c) => c.parents.length < 2); // hoppa över sammanslagningar
          knapp.hidden = /\/(entries|new)\b/.test(location.hash); // skymmer inte fälten när man redigerar
          knapp.classList.toggle('vantar', vantande.length > 0);
          knapp.textContent = vantande.length ? `Publicera (${vantande.length})` : 'Allt publicerat ✓';
        } catch { knapp.hidden = true; }
      }

      function visa() {
        lista.innerHTML = '';
        info.className = 'mpf-pub-info';
        if (!vantande.length) {
          info.textContent = 'Allt som sparats i admin syns redan på hemsidan.';
          go.disabled = true;
        } else {
          info.textContent = `${vantande.length} ${vantande.length === 1 ? 'sparad ändring väntar' : 'sparade ändringar väntar'} på att publiceras:`;
          for (const c of [...vantande].reverse()) {
            const li = document.createElement('li');
            li.textContent = snygga(c.commit.message) + ' ';
            const sm = document.createElement('small');
            sm.textContent = `· ${tid(c.commit.author.date)}`;
            li.append(sm);
            lista.append(li);
          }
          go.disabled = false;
        }
        panel.hidden = false;
      }

      async function publicera() {
        go.disabled = true;
        go.textContent = 'Publicerar…';
        try {
          const r = await gh('/merges', { method: 'POST', body: JSON.stringify({ base: 'main', head: 'utkast', commit_message: `Publicera ${vantande.length} ändringar från admin` }) });
          if (r.status === 409) throw new Error('Ändringarna krockar med något annat på hemsidan. Hör av dig till Kim.');
          if (!r.ok && r.status !== 204) throw new Error(`GitHub svarade ${r.status}.`);
          // Håll utkast i fas med main så att nästa omgång utgår från det publicerade
          if (r.status === 201) {
            const m = await r.json();
            await gh('/git/refs/heads/utkast', { method: 'PATCH', body: JSON.stringify({ sha: m.sha, force: false }) });
          }
          lista.innerHTML = '';
          info.className = 'mpf-pub-info ok';
          info.textContent = 'Publicerat! Ändringarna syns på hemsidan om 1–2 minuter.';
          vantande = [];
          kolla();
        } catch (e) {
          info.className = 'mpf-pub-info fel';
          info.textContent = 'Kunde inte publicera: ' + e.message;
          go.disabled = false;
        }
        go.textContent = 'Publicera alla';
      }

      knapp.addEventListener('click', visa);
      go.addEventListener('click', publicera);
      panel.querySelector('.mpf-pub-stang').addEventListener('click', () => (panel.hidden = true));
      panel.addEventListener('click', (e) => { if (e.target === panel) panel.hidden = true; });
      addEventListener('hashchange', () => setTimeout(kolla, 1500)); // efter en sparning byter admin vy
      addEventListener('storage', (e) => e.key === 'sveltia-cms.user' && kolla());
      setInterval(kolla, 20000);
      setTimeout(kolla, 1500);
    })();
  </script>

  <script src="/admin/cms/sveltia-cms.js"></script>
</body>
</html>
